{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "control_id",
    "state",
    "subject",
    "evidence_ids",
    "candidate_finding_ids",
    "evaluated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "control-result/v1"
    },
    "control_id": {
      "type": "string"
    },
    "state": {
      "enum": [
        "PASS",
        "FINDING",
        "NOT_APPLICABLE",
        "NOT_ENABLED",
        "UNAVAILABLE",
        "UNKNOWN_PERMISSION",
        "UNKNOWN_ERROR",
        "INCONCLUSIVE"
      ]
    },
    "subject": {
      "type": "object",
      "required": [
        "type",
        "identifier"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "repository",
            "branch",
            "local_branch",
            "worktree",
            "stash",
            "commit",
            "file",
            "workflow",
            "github_workflow",
            "github_job",
            "github_check",
            "ruleset",
            "pull_request",
            "issue",
            "dependency",
            "provider",
            "provider_check",
            "runtime"
          ]
        },
        "identifier": {
          "type": "string",
          "minLength": 1
        },
        "display_name": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "qualifiers": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "candidate_finding_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evaluated_at": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
