{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "audit",
    "repository",
    "snapshot",
    "profile",
    "plan_summary",
    "coverage",
    "control_results",
    "providers",
    "findings",
    "observations",
    "blind_spots",
    "remediation_tracks"
  ],
  "properties": {
    "schema_version": {
      "const": "audit-report/v1"
    },
    "audit": {
      "type": "object",
      "required": [
        "id",
        "mode",
        "started_at",
        "completed_at",
        "baseline_as_of"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "quick",
            "standard",
            "deep"
          ]
        },
        "started_at": {
          "type": "string"
        },
        "completed_at": {
          "type": "string"
        },
        "baseline_as_of": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "repository": {
      "type": "object",
      "required": [
        "full_name"
      ],
      "properties": {
        "full_name": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "snapshot": {
      "type": "object",
      "required": [
        "target_commit_sha"
      ],
      "properties": {
        "target_commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40,64}$"
        }
      },
      "additionalProperties": true
    },
    "profile": {
      "type": "object"
    },
    "plan_summary": {
      "type": "object",
      "required": [
        "catalog_controls",
        "applicable",
        "not_applicable"
      ],
      "properties": {
        "catalog_controls": {
          "type": "integer",
          "minimum": 0
        },
        "applicable": {
          "type": "integer",
          "minimum": 0
        },
        "not_applicable": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object"
    },
    "control_results": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "blind_spots": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "remediation_tracks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": false
}
